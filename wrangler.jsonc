{
  "name": "feed-alerts-trigger",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "REPO": "amul-mavlers/updates-monitor",
    "WORKFLOW": "feed-alerts.yml",
    "REF": "main"
  },
  "observability": { "enabled": true }
}
